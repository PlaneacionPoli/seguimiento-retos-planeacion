# =======================================
# CONFIGURACIÓN DE FIREBASE (BACKEND)
# =======================================
# Consola: https://console.firebase.google.com/ > Configuración del proyecto > Cuentas de servicio
# Opción A (recomendada en Render): pega aquí el contenido completo del JSON de la service account, en una sola línea.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Opción B (uso local): ruta a un archivo .json descargado, si prefieres no pegar el JSON en el .env.
FIREBASE_SERVICE_ACCOUNT_FILE=firebase-service-account.json
# Bucket de Storage, ej: tu-proyecto.appspot.com
FIREBASE_STORAGE_BUCKET=

# =======================================
# CONFIGURACIÓN DE FIREBASE (FRONTEND)
# =======================================
# Consola: https://console.firebase.google.com/ > Configuración del proyecto > Tus apps > Config del SDK
# Estos valores son públicos (se inyectan en el HTML), no son secretos.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=

# =======================================
# CONFIGURACIÓN DE LA APLICACIÓN
# =======================================
APP_NAME=Plan de Desarrollo Profesional
DEBUG=True
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Para producción, cambia:
# ENVIRONMENT=production
# ALLOWED_ORIGINS=https://tu-app.onrender.com

# =======================================
# CONFIGURACIÓN DE ARCHIVOS
# =======================================
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document
UPLOAD_DIR=uploads
EVIDENCIAS_PREFIX=evidencias
