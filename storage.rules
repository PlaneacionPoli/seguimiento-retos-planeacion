rules_version = '2';

// Igual que firestore.rules: el backend usa el Admin SDK y se salta esto.
// Sirve como defensa en profundidad si el cliente llegara a hablar directo con Storage.
service firebase.storage {
  match /b/{bucket}/o {
    match /evidencias/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
